<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgCadastroLogo"
            android:layout_width="60dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="36dp"
            android:contentDescription="@string/logo_proxima_etapa"
            android:src="@drawable/logo_proxima_etapa" />

        <TextView
            android:id="@+id/tvTituloCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/jaro"
            android:gravity="center"
            android:text="@string/titulo_cadastro"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="23dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="23dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="33dp"
                android:paddingTop="30dp"
                android:paddingEnd="33dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/etNome"
                    android:text="@string/label_nome_completo"
                    android:textColor="@color/purple_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="14dp"
                    android:hint="@string/hint_nome"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#FF595959"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@+id/etEmailCadastro"
                    android:text="@string/label_email"
                    android:textColor="@color/purple_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEmailCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_mail"
                    android:drawablePadding="14dp"
                    android:hint="@string/hint_email_cadastro"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLength="120"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#FF595959"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@+id/etTelefone"
                    android:text="@string/label_telefone"
                    android:textColor="@color/purple_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_phone"
                    android:drawablePadding="14dp"
                    android:hint="@string/hint_telefone"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#FF595959"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@+id/etSenhaCadastro"
                    android:text="@string/label_senha"
                    android:textColor="@color/purple_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSenhaCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="14dp"
                    android:hint="@string/hint_senha_cadastro"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLength="72"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#FF595959"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@+id/etConfirmaSenha"
                    android:text="@string/label_confirme_senha"
                    android:textColor="@color/purple_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etConfirmaSenha"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="14dp"
                    android:hint="@string/hint_senha_cadastro"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLength="72"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#FF595959"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvErroCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCadastrar"
                    android:layout_width="170dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="26dp"
                    android:elevation="6dp"
                    android:fontFamily="@font/jaro"
                    android:text="@string/btn_cadastrar"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    app:backgroundTint="@color/purple_dark"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="43dp"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tem_conta"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFacaLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/faca_login"
                android:textColor="@color/purple_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
